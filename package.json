{
  "name": "morning-agent",
  "version": "0.1.0",
  "private": true,
  "description": "One short Hebrew morning brief on Telegram: weather, AI news, concept of the day.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brief": "tsx src/cli.ts",
    "replay": "tsx src/replay-cli.ts",
    "report": "tsx src/report-cli.ts",
    "inbox": "tsx src/inbox-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "fast-xml-parser": "^5.11.2",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
