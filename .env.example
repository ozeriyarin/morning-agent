# Telegram bot token from @BotFather, used to send the brief.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Chat id of the recipient (your own chat with the bot).
TELEGRAM_CHAT_ID=000000000
# Anthropic API key for the decision model and the writer.
MORNING_ANTHROPIC_API_KEY=sk-ant-replace-me
# Apple ID email for iCloud Calendar over CalDAV (optional; iCloud is skipped unless both are set).
ICLOUD_USERNAME=you@example.com
# iCloud app-specific password from account.apple.com (optional; never your Apple ID password).
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# OpenRouter key for the Jev decision model (optional; used only when Jev is selected).
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Voyage AI key for memory embeddings (optional; without it the brief runs without memory).
VOYAGE_API_KEY=pa-replace-me
# GitHub token for the release feeds (optional; a fine-grained token with no permissions is enough).
# Without it api.github.com allows 60 calls an hour per IP, which a shared cloud egress exhausts.
GITHUB_TOKEN=github_pat_replace-me
